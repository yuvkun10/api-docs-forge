{
  "name": "api-docs-forge",
  "version": "0.1.0",
  "description": "Production-grade TypeScript CLI and API docs generator that emits OpenAPI, Markdown, and HTML from route code.",
  "type": "module",
  "bin": {
    "api-docs-forge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:moderate": "npm audit --audit-level=moderate",
    "check:outdated": "npm outdated"
  },
  "keywords": [
    "openapi",
    "typescript",
    "api-docs",
    "markdown",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
